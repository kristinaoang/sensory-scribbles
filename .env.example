# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Model ids from https://ai.google.dev/gemini-api/docs/models. Names only; the key stays server-side.
# Current child text model: gemini-3.5-flash-lite. Current safety model: gemini-3.8-flash.
GEMINI_CHILD_MODEL=""
GEMINI_SAFETY_MODEL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Tiger Data (TimescaleDB / PostgreSQL) connection string.
# Leave unset to use the built-in local SQLite persistence engine.
DATABASE_URL=""

# ADMIN_PASSWORD: Shared passcode for /admin moderation & bot automation.
# If unset, /admin shows a first-run setup form to claim an admin password.
ADMIN_PASSWORD=""

# SOLANA_RPC_URL: Solana Devnet RPC endpoint (defaults to https://api.devnet.solana.com).
SOLANA_RPC_URL="https://api.devnet.solana.com"

# SOLANA_SPONSOR_SECRET: Base58 or JSON-array server wallet secret key on Devnet for sponsoring entry anchors.
SOLANA_SPONSOR_SECRET=""

# GEMINI_TEXT_MODEL: Server-side model for campus quest wording and draw/write ideas.
# Current text model: gemini-3.8-flash
# https://ai.google.dev/gemini-api/docs/models
GEMINI_TEXT_MODEL=""

# GEMINI_TTS_MODEL: Build-time narration voice. No live call is required to enter the campus.
# Current speech model: gemini-3.8-flash-lite-tts
# https://ai.google.dev/gemini-api/docs/speech-generation
GEMINI_TTS_MODEL=""

# GEMINI_TTS_VOICE: Adult prebuilt voice. Current voice name: Kore
GEMINI_TTS_VOICE=""

